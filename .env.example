# Copy to .env (never commit the real file). Every value below is optional except the API key
# when LLM_PROVIDER=gemini.

# ---- LLM -----------------------------------------------------------------------------------
LLM_PROVIDER=gemini                       # gemini | fake | none
GEMINI_API_KEY=                           # required for gemini
LLM_MODEL=gemini-3.1-flash-lite
LLM_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.6-flash
LLM_ENRICHMENT_MODEL=                     # model for query variations (empty = LLM_MODEL)
LLM_TIMEOUT_S=20
LLM_ATTEMPTS_PER_MODEL=2
LLM_REPAIR_RETRIES=1                      # bounded re-asks after invalid output
LLM_THINKING_LEVEL=minimal
LLM_HEDGE_AFTER_S=5.0                     # duplicate slow requests (0 disables)
VARIATIONS_GRACE_S=0.3
LLM_TEMPERATURE=0.0
LLM_SEED=7
# Override published prices (USD per 1M tokens) when they change; unknown models report cost=null.
# LLM_PRICE_INPUT_PER_MTOK=0.25
# LLM_PRICE_OUTPUT_PER_MTOK=1.50

# ---- Embeddings / retrieval ------------------------------------------------------------------
EMBEDDING_PROVIDER=fastembed              # fastembed | hashing | gemini
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
BM25_K1=1.2
BM25_B=0.75
RETRIEVAL_TOP_K_BM25=25
RETRIEVAL_TOP_K_DENSE=25
RETRIEVAL_TOP_K_RERANK=12
HYBRID_W_BM25=0.45
HYBRID_W_DENSE=0.55
DEEPLINK_MIN_SCORE=0.50
DEEPLINK_MIN_MARGIN=0.03
DEEPLINK_MAPPER=hybrid                    # hybrid | bm25 | dense | rules | llm (ablations)

# ---- Cache -------------------------------------------------------------------------------------
CACHE_BACKEND=sqlite                      # sqlite | memory
SEMANTIC_CACHE_THRESHOLD=0.76             # calibrated: scripts/calibrate_cache.py
SEMANTIC_CACHE_THRESHOLD_NO_CONCEPT=0.93  # complaints outside the concept lexicon
SEMANTIC_CACHE_MARGIN=0.0
CACHE_KEY_MIN_SIMILARITY=0.55
CACHE_READ_ENABLED=true
CACHE_WRITE_ENABLED=true

# ---- SIIS knowledge retrieval (siis_response omitted) --------------------------------------------
SIIS_RETRIEVAL_ENABLED=true
SIIS_RETRIEVAL_MIN_SCORE=0.62
SIIS_RETRIEVAL_MIN_MARGIN=0.02

# ---- Data / limits / ops -------------------------------------------------------------------------
# DATA_DIR=data/official                  # default: data/official if it has deeplinks.json, else dev fixtures
MAX_QUERY_CHARS=2000
MAX_SIIS_CHARS=60000
LOG_LEVEL=INFO
LOG_FORMAT=json
HEALTH_REQUIRE_LLM=true
